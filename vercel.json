{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "beneath-the-empires-dh-project",
  "installCommand": "cd beneath-the-empires && npm install",
  "buildCommand": "cd beneath-the-empires && npm run build",
  "outputDirectory": "beneath-the-empires/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
